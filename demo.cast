[2.885481, "o", "st"]
[2.885488, "o", "/*"]
[2.885495, "o", "."]
[2.885502, "o", "wh"]
[2.885509, "o", "l\r\n"]
[2.941242, "o", "$ "]
[3.846426, "o", "uv "]
[3.846539, "o", "pip list\r\n"]
[3.859547, "o", "Package      Version\r\n------------ -------\r\nprettytable  3.18.0\r\nprimitive-db 0.1.0\r\nprompt       0.4.1\r\nwcwidth      0.9.4\r\n"]
[3.860219, "o", "$ "]
[4.764863, "o", "data"]
[4.764946, "o", "base\r\n"]
[5.157353, "o", "\r\n***База данных***\r\n\r\nУправление таблицами\r\n  create_table <таблица> <столбец:тип> ...   создать таблицу\r\n  list_tables                             показать список таблиц\r\n  drop_table <таблица>                    удалить таблицу\r\n  info <таблица>                          показать схему и число записей\r\n\r\nОперации с данными\r\n  insert into <таблица> values (...)      добавить запись\r\n  select from <таблица> [where поле = значение]   прочитать записи\r\n  update <таблица> set поле = значение where поле = значение\r\n  delete from <таблица> where поле = значение\r\n\r\nОбщие команды\r\n  help   показать справку\r\n  exit   выйти\r\n\r\n>>> Введите команду: "]
[6.062489, "o", "create_table users name:str age:int is_active:bool\r\n"]
[6.064306, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n>>> Введите команду: "]
[6.967138, "o", "list_tables\r\n"]
[6.967277, "o", "- users\r\n"]
[6.967287, "o", ">>> Введите команду: "]
[7.872487, "o", "insert into users values (\"Сергей\", true, true)\r\n"]
[7.873545, "o", "Функция insert выполнилась за 0.000 секунд\r\nОшибка валидации: Столбец \"age\" ожидает значение типа int.\r\n"]
[7.873716, "o", ">>> Введите команду: "]
[8.778932, "o", "insert into users values (\"Сергей\", 28, true)\r\n"]
[8.779614, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[8.781672, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n>>> Введите команду: "]
[9.682587, "o", "select from users where age = 28\r\n"]
[9.683014, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.909109, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Сергей |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>> Введите команду: "]
[10.814833, "o", "update users set age = 29 where ID = 1\r\n"]
[10.815926, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[10.816002, "o", ">>> Введите команду: "]
[11.717184, "o", "select from users\r\n"]
[11.717644, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[11.717973, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Сергей |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[11.71805, "o", ">>> Введите команду: "]
[12.623289, "o", "delete from users where ID = 1\r\n"]
[12.623962, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[13.525808, "o", "n\r\n"]
[13.52587, "o", "Операция отменена.\r\n"]
[13.525883, "o", ">>> Введите команду: "]
[14.42623, "o", "delete from users where ID = 1\r\n"]
[14.426609, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[15.331509, "o", "y\r\n"]
[15.332713, "o", "Запись с ID=1 в таблице \"users\" успешно удалена.\r\n>>> Введите команду: "]
[16.234473, "o", "info users\r\n"]
[16.234731, "o", "Таблица: users\r\n"]
[16.234748, "o", "Столбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[16.234825, "o", "Количество записей: 0\r\n"]
[16.234841, "o", ">>> Введите команду: "]
[17.138759, "o", "drop_table users\r\n"]
[17.140115, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[18.043105, "o", "y\r\n"]
[18.04454, "o", "Таблица \"users\" успешно удалена.\r\n"]
[18.044709, "o", ">>> Введите команду: "]
[18.949716, "o", "list_tables\r\n"]
[18.95002, "o", "Таблиц нет.\r\n>>> Введите команду: "]
[19.851544, "o", "exit\r\n"]
[19.862062, "o", "$ "]
[20.76725, "o", "exi"]
[20.767411, "o", "t\r\n"]
[20.767435, "o", "exit\r\n"]
