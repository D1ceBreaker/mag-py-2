[2.302771, "o", "\r\n***База данных***\r\n\r\nУправление таблицами\r\n  create_table <таблица> <столбец:тип> ...   |создать таблицу\r\n  list_tables                             |показать список таблиц\r\n  drop_table <таблица>                     |удалить таблицу\r\n  info <таблица>                           |показать схему и число записей\r\n\r\nОперации с данными\r\n  insert into <таблица> values (...)       |добавить запись\r\n  select from <таблица>                    |прочитать все записи\r\n  select from <таблица> where <столбец> = <значение>\r\n                                          |прочитать записи по условию\r\n  update <таблица> set <столбец> = <значение> where <столбец> = <значение>\r\n                                          |обновить записи\r\n  delete"]
[2.302806, "o", " from <таблица> where <столбец> = <значение>\r\n                                          |удалить записи\r\n\r\nОбщие команды\r\n  help                                    |показать справку\r\n  exit                                    |выйти\r\n\r\n>>> Введите команду: "]
[3.508147, "o", "create_table users name:str age:int is_active:bool\r\n"]
[3.510401, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[3.510507, "o", ">>> Введите команду: "]
[4.711767, "o", "list_tables\r\n"]
[4.71226, "o", "- users\r\n"]
[4.712304, "o", ">>> Введите команду: "]
[5.91405, "o", "insert into users values (\"Сергей\", true, true)\r\n"]
[5.914761, "o", "Функция insert выполнилась за 0.000 секунд\r\nОшибка валидации: Столбец \"age\" ожидает значение типа int.\r\n"]
[5.914941, "o", ">>> Введите команду: "]
[7.118956, "o", "insert into users values (\"Сергей\", 28, true)\r\n"]
[7.119757, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[7.120986, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[7.121091, "o", ">>> Введите команду: "]
[8.324044, "o", "select from users where age = 28\r\n"]
[8.324819, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[9.395294, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Сергей |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n>>> Введите команду: "]
[10.599899, "o", "update users set age = 29 where ID = 1\r\n"]
[10.601892, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n>>> Введите команду: "]
[11.803832, "o", "select from users\r\n"]
[11.80455, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[11.80515, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Сергей |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[11.805283, "o", ">>> Введите команду: "]
[13.007684, "o", "delete from users where ID = 1\r\n"]
[13.008472, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[14.210072, "o", "n\r\n"]
[14.210129, "o", "Операция отменена.\r\n"]
[14.21042, "o", ">>> Введите команду: "]
[15.411479, "o", "delete from users where ID = 1\r\n"]
[15.412111, "o", "Вы уверены, что хотите выполнить \"удаление записи\"? [y/n]: "]
[16.616439, "o", "y\r\n"]
[16.619091, "o", "Запись с ID=1 в таблице \"users\" успешно удалена.\r\n>>> Введите команду: "]
[17.821582, "o", "info users\r\n"]
[17.821849, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[17.821958, "o", "Количество записей: 0\r\n>>> Введите команду: "]
[19.024993, "o", "drop_table users\r\n"]
[19.025485, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[20.22659, "o", "y\r\n"]
[20.227262, "o", "Таблица \"users\" успешно удалена.\r\n>>> Введите команду: "]
[21.43133, "o", "list_tables\r\n"]
[21.431849, "o", "Таблиц нет.\r\n"]
[21.432013, "o", ">>> Введите команду: "]
[22.633265, "o", "exit\r\n"]
